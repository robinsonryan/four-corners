{
    "name": "@robinsonryan/four-corners",
    "version": "1.0.0",
    "type": "module",
    "description": "Vue components for document annotation with perspective transformation",
    "main": "resources/js/index.ts",
    "types": "resources/js/Types/index.ts",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --max-warnings=0",
        "typecheck": "vue-tsc --noEmit",
        "quality": "npm run lint:check && npm run typecheck && npm run test"
    },
    "dependencies": {
        "konva": "^9.3.0",
        "vue-konva": "^3.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^5.0.0",
        "@vue/test-utils": "^2.4.0",
        "@vue/tsconfig": "^0.7.0",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.9.0",
        "happy-dom": "^15.0.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.66.0",
        "vite": "^6.0.0",
        "vitest": "^2.0.0",
        "vue": "^3.5.0",
        "vue-tsc": "^2.0.0"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "vue": "^3.5.0"
    }
}
